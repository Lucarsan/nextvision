DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require
JWT_SECRET=gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Vídeo ao vivo pela borda da Cloudflare (Worker). Sem estas variáveis, o vídeo segue pelo proxy do Render.
# EDGE_VIDEO_KEY: 32 bytes aleatórios em base64url (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
EDGE_VIDEO_KEY=
EDGE_VIDEO_HOST=live.ficoupronto.com
# "all" ou slugs/ids de loja separados por vírgula
EDGE_VIDEO_TENANTS=
